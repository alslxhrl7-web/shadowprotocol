--- !u!114 &370271114
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 370271113}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5a98d78f0b43544385589216a1faade, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ShadowProtocol.MakingOfGallery
  entries:
  - title: "\uCEE8\uD14C\uC774\uB108(\uCD5C\uC885\uBCF8)"
    note: "VARCO \uD504\uB86C\uD504\uD2B8 \u2192 VARCO \uC0DD\uC131 \uC774\uBBF8\uC9C0 \u2192 VARCO 3D \uC6D0\uBCF8(\uC606\uD310 \uBB3C\uACB0\xB7\uCCA0\uBB3C \uBB49\uAC1C\uC9D0) \u2192 Blender\uC5D0\uC11C ISO 20ft \uCE58\uC218\uB85C \uC0C8\uB85C \uBAA8\uB378\uB9C1(\uACE8\uD310\xB7\uC8FC\uBB3C\xB7\uBB38 \uCCA0\uBB3C, LOD 5550/2578/928 tris, PBR 5\uC885) \u2192 \uAC8C\uC784 \uC548\n\uCE58\uC218 6.058 \xD7 2.438 \xD7 2.591m, \uC57C\uB4DC \uCEE8\uD14C\uC774\uB108 \uC804\uBD80 \uC774 \uBAA8\uB378\uB85C \uAD50\uCCB4"
    stages:
    - caption: "VARCO \uD504\uB86C\uD504\uD2B8"
      image: {fileID: 0}
      text: "<b><color=#59D9FF>VARCO 3D \uD504\uB86C\uD504\uD2B8 (GenerateImage \u2192 Generate3D, tri 6000, texture 2048, PBR)</color></b>\n\n<i>Single prop: a closed 20-foot shipping container, weathered dark red corrugated steel with rust streaks, double doors with locking bars on the front end, stylized realistic PBR game prop. Entire container fully visible and centered, 3/4 view from slightly above showing the doors, plain pure white background, soft even studio lighting, no cast shadow, no text, no logo</i>"
    - caption: "VARCO \uC0DD\uC131 \uC774\uBBF8\uC9C0(GenerateImage)"
      image: {fileID: 21300000, guid: 9c5a0b4b4fa0ff445a8f5cc17c501062, type: 3}
      text: 
    - caption: "VARCO 3D \uC6D0\uBCF8 \uBA54\uC2DC(Generate3D) \u2014 \uB9E4\uD2B8\uCEA1"
      image: {fileID: 21300000, guid: 9ff3c6cf3211acb46bf02ec2359872ee, type: 3}
      text: 
    - caption: "VARCO \uC6D0\uBCF8 \u2192 Blender \uCD5C\uC885\uBCF8 \uC804\uD6C4 \uBE44\uAD50"
      image: {fileID: 21300000, guid: d859fff2e8b03de40a418b10ddfb8100, type: 3}
      text: 
    - caption: "Blender \uCD5C\uC885\uBCF8 \u2014 LOD0/1/2 \uD615\uD0DC(\uB9E4\uD2B8\uCEA1)"
      image: {fileID: 21300000, guid: 25f2cb5e52bb43c4b9e99d847c829215, type: 3}
      text: 
    - caption: "Blender \uCD5C\uC885\uBCF8 \u2014 \uBB38 \uCCA0\uBB3C \uADFC\uC811"
      image: {fileID: 21300000, guid: 3d89c5a27132169458eae1fe647daacd, type: 3}
      text: 
    - caption: "Blender \uCD5C\uC885\uBCF8 \u2014 \uBAA8\uC11C\uB9AC \uC8FC\uBB3C \uADFC\uC811"
      image: {fileID: 21300000, guid: b6048269b8bd1b04a8916d2567150d7d, type: 3}
      text: 
    - caption: "Blender \uCD5C\uC885 \uB80C\uB354(\uBB38 \uCABD)"
      image: {fileID: 21300000, guid: 380c806ff9db32f4f9a42ffcbf241223, type: 3}
      text: 
    - caption: "Blender \uCD5C\uC885 \uB80C\uB354(\uC55E \uBCBD \uCABD)"
      image: {fileID: 21300000, guid: e16c74e800b91884c9e122d1d3357762, type: 3}
      text: 
    model: {fileID: 919132149155446097, guid: 6a8d8f5fc0cb88d42b1707911ee08485, type: 3}
    controller: {fileID: 0}
    yaw: 30
