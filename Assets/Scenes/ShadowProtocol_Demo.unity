  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ShadowProtocol.MakingOfGallery
  entries:
  - title: "\uCEE8\uD14C\uC774\uB108"
    note: "VARCO 3D \uC0DD\uC131 \u2192 Blender \uC815\uB9AC(\uCD95\xB7\uC2A4\uCF00\uC77C\xB7\uC7AC\uC9C8\xB7LOD)\n\uACF5\uC815: VARCO \uD504\uB86C\uD504\uD2B8 \u2192 VARCO \uC0DD\uC131 \uC774\uBBF8\uC9C0 \u2192 VARCO \uC6D0\uBCF8 \uBA54\uC2DC \u2192 Blender \uC815\uB9AC \u2192 \uAC8C\uC784 \uC548.  (\uD504\uB86C\uD504\uD2B8\xB7\uC6D0\uBCF8 \uBA54\uC2DC \uB80C\uB354\uB294 \uC790\uB8CC\uB97C \uBC1B\uB294 \uB300\uB85C \uCD94\uAC00)"
    stages:
    - caption: "VARCO 3D \uC0DD\uC131 \uC774\uBBF8\uC9C0"
      image: {fileID: 21300000, guid: 68b6d7e775d02364c8e2dcc634305a56, type: 3}
      text: 
    - caption: "Blender \uC815\uB9AC \uD6C4 \u2014 \uD615\uD0DC(\uB9E4\uD2B8\uCEA1)"
      image: {fileID: 21300000, guid: be6562676bc72a74a8d4d27dce55d71a, type: 3}
      text: 
    - caption: "Blender \uC815\uB9AC \uD6C4 \u2014 \uD14D\uC2A4\uCC98"
      image: {fileID: 21300000, guid: 3030098511ba22a47a947aef5bda77d8, type: 3}
      text: 
    model: {fileID: 919132149155446097, guid: 94a50980bca15d449bb3c7cc0876420d, type: 3}
    controller: {fileID: 0}
    yaw: 30
    pending: 1
  - title: "\uD50C\uB808\uC774\uC5B4(\uC7A0\uC785 \uC694\uC6D0)"
    note: "VARCO 3D \uC0DD\uC131 \u2192 Blender \uC815\uB9AC\xB7\uB9AC\uAE45 \u2192 VARCO Animate \uC560\uB2C8\uBA54\uC774\uC158 9\uC885(Humanoid \uB9AC\uD0C0\uAC9F)\n\uACF5\uC815 \uC774\uBBF8\uC9C0\uB294 \uC790\uB8CC\uB97C \uBC1B\uB294 \uB300\uB85C \uCD94\uAC00. \uC9C0\uAE08\uC740 \uAC8C\uC784 \uBAA8\uB378 \uD134\uD14C\uC774\uBE14\uB9CC."
